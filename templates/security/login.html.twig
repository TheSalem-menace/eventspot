{% extends 'base.html.twig' %}
{% block title %}Connexion — EventSpot{% endblock %}
{% block body %}
<div class="container py-5" style="max-width:450px;">
    <div class="card border-0 shadow">
        <div class="card-body p-5">
            <h2 class="fw-bold text-center mb-4">🔑 Connexion</h2>
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" name="_username" class="form-control" value="{{ last_username }}" autofocus required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mot de passe</label>
                    <input type="password" name="_password" class="form-control" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn btn-primary w-100 btn-lg">Se connecter</button>
            </form>
            <hr>
            <p class="text-center mb-0">
                Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a>
            </p>
            <p class="text-center text-muted small mt-2">
                <strong>Test :</strong> admin@eventspot.fr / admin123
            </p>
        </div>
    </div>
</div>
{% endblock %}
