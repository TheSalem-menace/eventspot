{% extends 'base.html.twig' %}
{% block title %}Événements — EventSpot{% endblock %}
{% block body %}
<div class="container py-4">
    <h1 class="fw-bold mb-4">📋 Tous les événements</h1>

    {# Formulaire de recherche #}
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('app_evenement_index') }}" class="row g-3">
                <div class="col-md-3">
                    <input type="text" name="titre" class="form-control" placeholder="Rechercher un titre..."
                           value="{{ filters.titre }}">
                </div>
                <div class="col-md-2">
                    <select name="categorie" class="form-select">
                        <option value="">Toutes les catégories</option>
                        {% for val, label in {'conference':'Conférence','atelier':'Atelier','meetup':'Meetup','formation':'Formation','concert':'Concert'} %}
                            <option value="{{ val }}" {{ filters.categorie == val ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="text" name="ville" class="form-control" placeholder="Ville..."
                           value="{{ filters.ville }}">
                </div>
                <div class="col-md-3">
                    <select name="tag" class="form-select">
                        <option value="">Tous les tags</option>
                        {% for tag in tags %}
                            <option value="{{ tag.id }}" {{ filters.tagId == tag.id ? 'selected' : '' }}>{{ tag.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">🔍 Filtrer</button>
                    <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary">✕</a>
                </div>
            </form>
        </div>
    </div>

    {% if pagination.totalItemCount == 0 %}
        <div class="alert alert-info">Aucun événement trouvé.</div>
    {% else %}
        <p class="text-muted">{{ pagination.totalItemCount }} événement(s) trouvé(s)</p>
        <div class="row g-4">
            {% for evenement in pagination %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 event-card border-0 shadow-sm">
                    {% if evenement.imageName %}
                        <img src="{{ asset('uploads/evenements/' ~ evenement.imageName) }}"
                             class="card-img-top" style="height:160px;object-fit:cover;" alt="{{ evenement.titre }}">
                    {% else %}
                        <div class="card-img-top d-flex align-items-center justify-content-center text-white"
                             style="height:160px;background:linear-gradient(135deg,#1a1a2e,#0f3460);">
                            <span style="font-size:2.5rem;">
                                {% if evenement.categorie == 'conference' %}🎤
                                {% elseif evenement.categorie == 'atelier' %}🔧
                                {% elseif evenement.categorie == 'meetup' %}🤝
                                {% elseif evenement.categorie == 'formation' %}📚
                                {% else %}🎵{% endif %}
                            </span>
                        </div>
                    {% endif %}
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge bg-secondary">{{ evenement.categorie }}</span>
                            {% for tag in evenement.tags %}
                                <span class="badge" style="background:{{ tag.couleur }}">{{ tag.nom }}</span>
                            {% endfor %}
                        </div>
                        <h5 class="card-title fw-bold flex-grow-1">{{ evenement.titre }}</h5>
                        <p class="text-muted small mb-1">
                            <i class="fas fa-calendar me-1"></i>{{ evenement.dateDebut|date('d/m/Y à H:i') }}
                            <span class="text-muted"> ({{ evenement.dateDebut|time_ago }})</span>
                        </p>
                        <p class="text-muted small mb-2">
                            <i class="fas fa-map-marker-alt me-1"></i>{{ evenement.lieu.nom }}, {{ evenement.lieu.ville }}
                        </p>
                        <div class="mb-1">{{ evenement.prix|price_format|raw }}</div>
                        <div class="mb-1">{{ capacity_badge(evenement.placesRestantes, evenement.capaciteMax)|raw }}</div>
                        <div class="progress mb-2" title="{{ evenement.tauxRemplissage }}% rempli">
                            <div class="progress-bar {{ evenement.tauxRemplissage >= 80 ? 'bg-danger' : (evenement.tauxRemplissage >= 50 ? 'bg-warning' : 'bg-success') }}"
                                 style="width:{{ evenement.tauxRemplissage }}%"></div>
                        </div>
                        <a href="{{ path('app_evenement_show', {id: evenement.id}) }}" class="btn btn-primary mt-auto">
                            Voir l'événement →
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% endif %}
</div>
{% endblock %}
