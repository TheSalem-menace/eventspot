{% extends 'base.html.twig' %}
{% block title %}{{ evenement ? 'Modifier' : 'Créer' }} un événement — EventSpot{% endblock %}
{% block body %}
<div class="container py-4" style="max-width:800px;">
    <h1 class="fw-bold mb-4">{{ evenement ? '✏️ Modifier l\'événement' : '➕ Créer un événement' }}</h1>
    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    <div class="card shadow border-0">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12">{{ form_row(form.titre) }}</div>
                <div class="col-12">{{ form_row(form.description) }}</div>
                <div class="col-md-6">{{ form_row(form.dateDebut) }}</div>
                <div class="col-md-6">{{ form_row(form.dateFin) }}</div>
                <div class="col-md-8">{{ form_row(form.lieu) }}</div>
                <div class="col-md-4">{{ form_row(form.capaciteMax) }}</div>
                <div class="col-md-4">{{ form_row(form.prix) }}</div>
                <div class="col-md-8">{{ form_row(form.categorie) }}</div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Tags</label>
                    <div class="d-flex flex-wrap gap-2">
                        {{ form_widget(form.tags) }}
                    </div>
                    {{ form_errors(form.tags) }}
                </div>
            </div>
        </div>
        <div class="card-footer bg-transparent d-flex gap-2 p-4">
            <button type="submit" class="btn btn-primary px-5">
                {{ evenement ? '💾 Enregistrer' : '🚀 Publier l\'événement' }}
            </button>
            <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
