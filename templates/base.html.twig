<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EventSpot{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <style>
        .navbar-brand { font-size: 1.4rem; }
        .event-card { transition: transform .2s; }
        .event-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.12); }
        .badge-tag { font-size: .8rem; }
        .progress { height: 8px; }
        .hero { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); }
        footer { background: #1a1a2e; }
    </style>
    {% block stylesheets %}{% endblock %}
    {{ importmap('app') }}
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark" style="background:#1a1a2e;">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
            🎫 EventSpot
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_evenement_index') }}">📋 Événements</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_lieu_index') }}">🏛️ Lieux</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_tag_evenement_index') }}">🏷️ Tags</a>
                </li>
                {% if is_granted('ROLE_ORGANISATEUR') %}
                <li class="nav-item">
                    <a class="nav-link btn btn-outline-success btn-sm ms-2 px-3 text-success"
                       href="{{ path('app_evenement_new') }}">➕ Créer un événement</a>
                </li>
                {% endif %}
            </ul>
            <ul class="navbar-nav ms-auto">
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            👤 {{ app.user.pseudo }}
                            {% if is_granted('ROLE_ADMIN') %}<span class="badge bg-danger ms-1">Admin</span>
                            {% elseif is_granted('ROLE_ORGANISATEUR') %}<span class="badge bg-warning text-dark ms-1">Orga</span>
                            {% endif %}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">🚪 Se déconnecter</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">🔑 Connexion</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-primary btn-sm ms-2 px-3"
                           href="{{ path('app_register') }}">✍️ Inscription</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<main>
    {% block body %}{% endblock %}
</main>

<footer class="text-white text-center py-4 mt-5">
    <p class="mb-0">© 2026 <strong>EventSpot</strong> — Tous droits réservés</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
